doctype html

html
  head
    title Students Management - Motivational Images
  body
    if username
      h1 Hi #{username}!  
    else
      h1 Hi!

    h2 Welcome to the Students Management Website
    h3 Here are a few images to motivate you!
   
    table(width="80%" height="99%" border="1" cellpadding="10" cellspacing="0")
        tbody            
            tr
                td(align="center")
                    img(src='./images/Image1.jpg', style='width: 600px;')  
            tr
                td(align="center")
                    img(src='./images/Image2.jpg', style='width: 600px;')    
                     